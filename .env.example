# Copy to .env for local development. Never commit real values.

# PostgreSQL (Neon via Vercel sets this automatically). For local tests SQLite works:
DATABASE_URL=sqlite:///./local.db

# Optional: a contact email for Crossref's "polite pool" (faster, more reliable API access)
CROSSREF_MAILTO=

# Optional: free OpenAlex API key from https://openalex.org/settings/api
OPENALEX_API_KEY=

# Stage 1b (AI agents) — not used yet
LLM_PROVIDER=
LLM_API_KEY=
